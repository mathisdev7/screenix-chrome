{
  "name": "screenix-for-chrome",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc -b && vite build && vite build -c vite.content.config.ts --mode pointer-tracker && vite build -c vite.content.config.ts --mode license-bridge && vite build -c vite.content.config.ts --mode countdown-overlay",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "bun test",
    "test:e2e": "bun run build && bun e2e/recording.ts",
    "cursors": "bun scripts/cursors/generate.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tabler/icons-react": "^3.46.0",
    "clsx": "^2.1.1",
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.3.4",
    "@types/chrome": "^0.1.32",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
